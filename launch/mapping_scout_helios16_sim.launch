<launch>
  <arg name="rviz" default="true" />
  <rosparam command="load" file="$(find faster_lio)/config/scout_helios16_sim.yaml" />
  <param name="runtime_pos_log_enable" type="bool" value="true" />
  <node pkg="faster_lio" type="run_mapping_online" name="laserMapping" output="screen" />
  <!-- Scout mesh follows LIO via TF. Gazebo must not also parent base_link. -->
  <include file="$(find faster_lio)/launch/scout_in_lio_tf.launch">
    <arg name="load_description" value="false"/>
    <arg name="imu_z" value="0.12"/>
  </include>
  <!-- Display-only ground removal. LIO still consumes the full cloud. -->
  <node name="ground_segmentation" pkg="patchworkpp" type="demo" output="screen">
    <rosparam command="load" file="$(find faster_lio)/config/patchworkpp_scout.yaml"/>
    <param name="cloud_topic" value="/cloud_registered_body"/>
  </node>
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find faster_lio)/config/rviz/scout_helios16.rviz" />
  </group>
</launch>

